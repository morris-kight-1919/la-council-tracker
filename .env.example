# Copy this file to .env and adjust as needed. .env is not committed.

# 1 = show sample/placeholder data only (safe demo mode, no real data touched)
# 0 = read the real pipeline data (corpus.db, watchlist.json, data/*.json) -- default
SEED_MODE=0

# Used to sign Flask's session/flash cookies. Any random string is fine for
# a local-only tool with no login -- change it if you ever want existing
# flash messages invalidated.
FLASK_SECRET_KEY=change-me-to-any-random-string

# Port the local server listens on. Always bound to 127.0.0.1, never 0.0.0.0.
PORT=5055
